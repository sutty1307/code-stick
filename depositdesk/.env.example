# Set variables in your shell/process manager. The app does not load this file.
DEPOSITDESK_DATA_DIR=/var/lib/depositdesk
DEPOSITDESK_BUSINESS_NAME=My business
DEPOSITDESK_PROVIDER=simulator
DEPOSITDESK_ORIGIN=http://127.0.0.1:8765
# Behind an HTTPS proxy, set your exact public origin, enable this flag, and
# list only the proxy's actual connecting addresses. Loopback defaults suit nginx on the same host.
DEPOSITDESK_BEHIND_PROXY=false
DEPOSITDESK_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# init/passwd only: prefer a private secret file over an environment password.
# DEPOSITDESK_OWNER_PASSWORD_FILE=/run/secrets/desk-owner-password
# Optional sandbox uses a SEPARATE data directory and existing sandbox accounts.
# DWOLLA_SANDBOX_KEY=
# DWOLLA_SANDBOX_SECRET=
# DWOLLA_SANDBOX_SOURCE_ID=
# DWOLLA_SANDBOX_WEBHOOK_SECRET=
# DWOLLA_SANDBOX_CUSTOMER_ID=
# DWOLLA_SANDBOX_DESTINATION_ID=
