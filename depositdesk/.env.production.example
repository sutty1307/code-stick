# Deployment template only. The app does not automatically load this file.
# Configure these in the service environment. Keep secrets outside source control.
DEPOSITDESK_PROVIDER=dwolla_production
DEPOSITDESK_DATA_DIR=/var/lib/depositdesk/live
DEPOSITDESK_ORIGIN=https://pay.example.com
DEPOSITDESK_BUSINESS_NAME=My business
DEPOSITDESK_ENABLE_LIVE_PAYMENTS=false
DEPOSITDESK_BEHIND_PROXY=true
DEPOSITDESK_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Provider-issued IDs; use the Main Account and its verified ACH-capable bank.
DWOLLA_PRODUCTION_ACCOUNT_ID=
DWOLLA_PRODUCTION_SOURCE_ID=
# Create these through the host's secret manager or private server files.
DWOLLA_PRODUCTION_KEY_FILE=/etc/depositdesk/secrets/production-key
DWOLLA_PRODUCTION_SECRET_FILE=/etc/depositdesk/secrets/production-secret
DWOLLA_PRODUCTION_WEBHOOK_SECRET_FILE=/etc/depositdesk/secrets/production-webhook
# Owner initialization/password rotation only:
# DEPOSITDESK_OWNER_PASSWORD_FILE=/etc/depositdesk/secrets/owner-password
